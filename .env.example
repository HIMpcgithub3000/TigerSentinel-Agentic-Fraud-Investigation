# TigerGraph Savanna / Cloud or Community Edition
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_API_TOKEN=your_token
TG_SECRET=your_secret
TG_TGCLOUD=true
TG_RESTPP_PORT=9000
TG_GS_PORT=14240

# LLM Provider (Optional / Fallback to local grounded prompt)
OPENAI_API_KEY=your_openai_key
LLM_MODEL=gpt-4o

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8787
UI_PORT=5173
DEMO_MODE=true
USE_LOCAL_GRAPH_ENGINE=true
