# ==============================================================================
# TigerGraph Savanna / Cloud or Community Edition
# ==============================================================================
TG_HOST=https://your-workspace-subdomain.i.tgcloud.io
TG_GRAPHNAME=fraudstate
TG_USERNAME=your-email@example.com
TG_PASSWORD=your_password
TG_API_TOKEN=your_jwt_api_token
TG_SECRET=your_database_secret
TG_TGCLOUD=true
TG_RESTPP_PORT=443
TG_GS_PORT=443

# ==============================================================================
# Optional LLM Provider (Falls back to grounded deterministic prompt)
# ==============================================================================
OPENAI_API_KEY=your_openai_key
LLM_MODEL=gpt-4o

# ==============================================================================
# Application Configuration
# ==============================================================================
APP_HOST=127.0.0.1
APP_PORT=8787
UI_PORT=5173
DEMO_MODE=true

# Set to true for instantaneous local evaluation (recommended for benchmarks)
# Set to false to execute all queries against live TigerGraph Savanna Cloud
USE_LOCAL_GRAPH_ENGINE=true
