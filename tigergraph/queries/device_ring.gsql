// GSQL Query: device_ring
// Deep-Dive Multi-Hop Traversal (up to 3 hops)
// Discovers multi-card, multi-customer sharing of device profiles, secondary device bridges, and historical fraud cases
USE GRAPH fraudstate

CREATE OR REPLACE QUERY device_ring(VERTEX<DeviceProfile> profile_id, STRING as_of_ts, INT max_hops = 3) FOR GRAPH fraudstate {
    SetAccum<VERTEX<Transaction>> @@connected_txns;
    SetAccum<VERTEX<Card>> @@connected_cards;
    SetAccum<VERTEX<DeviceProfile>> @@connected_devices;
    SetAccum<VERTEX<Customer>> @@connected_customers;
    SetAccum<VERTEX<ClosedCase>> @@prior_fraud_cases;
    SumAccum<DOUBLE> @@syndicate_exposure_usd;

    TargetProfile = { profile_id };
    @@connected_devices += profile_id;

    // Hop 1: Transactions using the target device profile
    Txns = SELECT t FROM TargetProfile:p -(DEVICE_USED_IN:e)-> Transaction:t
           WHERE t.ts <= as_of_ts
           ACCUM @@connected_txns += t,
                 @@syndicate_exposure_usd += t.amount;

    // Hop 1: Cards making those transactions
    Cards = SELECT cd FROM Txns:t -(MADE_BY:e)-> Card:cd
            ACCUM @@connected_cards += cd;

    // Hop 1: Customers owning those cards
    Customers = SELECT cust FROM Cards:cd -(OWNED_BY:e)-> Customer:cust
                ACCUM @@connected_customers += cust;

    // Hop 2: Other cards owned by those customers
    OtherCards = SELECT cd FROM Customers:cust -(OWNS:e)-> Card:cd
                 ACCUM @@connected_cards += cd;

    // Hop 2: Other transactions from those cards
    OtherTxns = SELECT t FROM OtherCards:cd -(MADE:e)-> Transaction:t
                WHERE t.ts <= as_of_ts
                ACCUM @@connected_txns += t,
                      @@syndicate_exposure_usd += t.amount;

    // Hop 2: Other devices linked to those transactions
    OtherDevices = SELECT dev FROM OtherTxns:t -(FROM_DEVICE:e)-> DeviceProfile:dev
                   ACCUM @@connected_devices += dev;

    // Closed cases linked to other cards
    Cases = SELECT cs FROM OtherCards:cd -(HAD_CLOSED_CASE:e)-> ClosedCase:cs
            WHERE cs.closed_at <= as_of_ts
            ACCUM @@prior_fraud_cases += cs;

    // Closed cases linked to target cards
    CasesTarget = SELECT cs FROM Cards:cd -(HAD_CLOSED_CASE:e)-> ClosedCase:cs
                  WHERE cs.closed_at <= as_of_ts
                  ACCUM @@prior_fraud_cases += cs;

    PRINT profile_id, 
          @@connected_devices.size() AS num_devices_in_ring,
          @@connected_cards.size() AS num_cards_in_ring,
          @@connected_customers.size() AS num_customers_in_ring,
          @@connected_txns.size() AS num_transactions_in_ring,
          @@prior_fraud_cases.size() AS prior_fraud_cases_count,
          @@syndicate_exposure_usd AS total_syndicate_exposure,
          (@@connected_cards.size() >= 3 OR @@prior_fraud_cases.size() > 0) AS is_syndicate,
          @@connected_devices,
          @@connected_cards,
          @@connected_customers,
          @@prior_fraud_cases;
}
