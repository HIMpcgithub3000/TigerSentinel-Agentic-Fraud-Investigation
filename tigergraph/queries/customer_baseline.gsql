// GSQL Query: customer_baseline
// Retrieves customer profile, owned cards, historical transaction stats before as_of_ts
USE GRAPH fraudstate

CREATE OR REPLACE QUERY customer_baseline(VERTEX<Customer> customer_id, STRING as_of_ts) FOR GRAPH fraudstate {
    SumAccum<DOUBLE> @amt;
    ListAccum<VERTEX<Card>> @@cards;
    ListAccum<STRING> @@regions;
    SumAccum<INT> @@txn_count;
    SumAccum<DOUBLE> @@total_spend;
    MaxAccum<DOUBLE> @@max_spend;
    MinAccum<DOUBLE> @@min_spend;

    TargetCustomer = { customer_id };

    Cards = SELECT cd FROM TargetCustomer:c -(OWNS:e)-> Card:cd
            ACCUM @@cards += cd;

    Txns = SELECT t FROM Cards:cd -(MADE:e)-> Transaction:t
           WHERE t.ts <= as_of_ts
           ACCUM 
               @@txn_count += 1,
               @@total_spend += t.amount,
               @@max_spend += t.amount,
               @@min_spend += t.amount,
               @@regions += t.addr1;

    PRINT customer_id, @@cards, @@txn_count, @@total_spend, 
          (@@total_spend / CASE WHEN @@txn_count > 0 THEN @@txn_count ELSE 1 END) AS avg_spend,
          @@max_spend, @@min_spend, @@regions;
}
