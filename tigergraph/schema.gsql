// TigerGraph Schema for Agentic Fraud Investigation (FraudGraph)
// Hackathon: TigerGraph x Hacker House Goa 2026

// -------------------------------------------------------------
// Vertices (Global Types)
// -------------------------------------------------------------

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card1 STRING,
    card2 STRING,
    card3 STRING,
    card4 STRING,
    card6 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID transaction_id STRING,
    ts STRING,
    amount DOUBLE,
    channel STRING,
    risk_score DOUBLE,
    addr1 STRING,
    addr2 STRING,
    product_cd STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID profile_id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    resolution STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at STRING,
    closed_at STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX InvestigationCase (
    PRIMARY_ID case_id STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    exposure_usd DOUBLE,
    status STRING,
    summary STRING,
    written_to_graph BOOL,
    created_at STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// -------------------------------------------------------------
// Edges
// -------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN";
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_USED_IN";
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_BILLED_FOR";

CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN_CASE";
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="HAD_CLOSED_CASE";
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="LINKED_BY_CASE";

CREATE DIRECTED EDGE INVESTIGATION_TARGETS (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="INVESTIGATED_IN";
CREATE DIRECTED EDGE INVESTIGATION_INVOLVES_CARD (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="CARD_IN_INVESTIGATION";
CREATE DIRECTED EDGE INVESTIGATION_CITES_CASE (FROM InvestigationCase, TO ClosedCase) WITH REVERSE_EDGE="CITED_BY_INVESTIGATION";

// -------------------------------------------------------------
// Graph Definition
// -------------------------------------------------------------

CREATE GRAPH FraudGraph (*)
